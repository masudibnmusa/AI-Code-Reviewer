# ============================================================
# .env.example — Environment variable template
# ============================================================

# --- Server ---
PORT=8000

# --- GitHub ---
GITHUB_TOKEN=ghp_your_github_token_here
WEBHOOK_SECRET=your_github_webhook_secret_here

# --- GitLab ---
GITLAB_TOKEN=glpat_your_gitlab_token_here
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_here

# --- LLM ---
LLM_API_KEY=sk-ant-your_api_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

# --- Review behavior ---
MAX_FILES_PER_REVIEW=50
CONTEXT_LINES=15
ENABLE_STATIC_ANALYSIS=true
ENABLE_INLINE_COMMENTS=false
MIN_SEVERITY=nitpick

# --- Rate limiting ---
RATE_LIMIT_RPM=30